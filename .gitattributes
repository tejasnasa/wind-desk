# Normalise line endings on check-in so the tree is identical on every platform.
* text=auto eol=lf

# Windows scripts must keep CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary assets.
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.db binary
*.mp4 binary
*.pdf binary
