# Wind Desk - environment template. Copy to .env and adjust as needed.
# Every value has a working default in backend/app/config.py.

# --- market rules -----------------------------------------------------------
# Day-ahead (SDW) gate closure, local time in MARKET_TIMEZONE.
GATE_CLOSURE_TIME=11:00
MARKET_TIMEZONE=Europe/London

# --- storage ----------------------------------------------------------------
# Path to the SQLite store. In Docker Compose this is bind-mounted to /data.
WIND_DB_PATH=backend/data/wind.db
# Set to 1 on read-only platforms (Vercel serverless) to open SQLite read-only.
SQLITE_READONLY=0
# Any SQLAlchemy URL works, e.g. postgresql+psycopg://user:pass@host/db
# DATABASE_URL=sqlite:///backend/data/wind.db

# --- data source ------------------------------------------------------------
ELEXON_API_BASE=https://data.elexon.co.uk/bmrs/api/v1
ELEXON_TIMEOUT_S=90
ELEXON_RETRIES=3
HTTP_USER_AGENT=wind-desk/1.0 (day-ahead wind forecast & accuracy portal)

# --- ingestion windows ------------------------------------------------------
ACTUAL_FROM=2025-12-01
ACTUAL_TO=2026-02-15
FORECAST_PUBLISH_FROM=2025-12-20
FORECAST_PUBLISH_TO=2026-02-01

# --- analysis window (the pilot scope) --------------------------------------
ANALYSIS_FROM=2026-01-01
ANALYSIS_TO=2026-01-31

# --- api --------------------------------------------------------------------
CORS_ORIGINS=*
# Token required by POST /api/admin/ingest. Leave empty to disable the route.
ADMIN_TOKEN=
# Serve a built single-page app from this directory (combined container).
STATIC_DIR=
